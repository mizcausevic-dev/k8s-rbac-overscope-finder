{
  "name": "k8s-rbac-overscope-finder",
  "version": "0.1.0",
  "description": "Scan a directory of Kubernetes YAML manifests for over-scoped RBAC: wildcard verbs/resources/apiGroups, escalation verbs (escalate/bind/impersonate), pod-exec / pod-portforward / pod-attach, Secret-read rules, cluster-admin bindings, and system:masters group bindings. Pure offline transform — no cluster access. Library + CLI.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "mizcausevic-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/mizcausevic-dev/k8s-rbac-overscope-finder"
  },
  "keywords": [
    "kubernetes",
    "k8s",
    "rbac",
    "security",
    "platform-engineering",
    "least-privilege",
    "manifests",
    "yaml",
    "ci",
    "typescript"
  ],
  "bin": {
    "k8s-rbac-overscope-finder": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "demo": "tsx src/cli.ts fixtures/rbac --format summary",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.7"
  }
}
